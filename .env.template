# Copy this file to ".env" in the project root, then fill in the values.
# บน Vercel ไม่ต้องมีไฟล์นี้ — ใส่ค่าใน Project Settings → Environment Variables แทน
# ต้องมีเฉพาะ 2 ตัว: MONGODB_URI และ GEMINI_API_KEY

# MongoDB connection string (Atlas หรือ local) — ใช้ต่อเชื่อมต่อฐานข้อมูล
MONGODB_URI=<YOUR_MONGODB_URI>

# API key from Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ── ตัวแปรเฉพาะตอน dev เท่านั้น ─────────────────────────────────
# เก็บไว้เพื่ออ้างอิง โค้ดอ่านค่าเหล่านี้จาก MONGODB_URI เพียงตัวเดียว
# MONGODB_USERNAME=<YOUR_MONGO_USERNAME>
# MONGODB_PASSWORD=<YOUR_MONGO_PASSWORD>

# Port ของ backend ตอน dev (Vercel ไม่ใช้ค่านี้)
PORT_BACKEND=3222

# ── ตัวแปรเลือก (ไม่บังคับ) ───────────────────────────────────────
# ล็อกโมเดล Gemini ที่ใช้ (ปกติระบบไล่จากรายการใน MODEL_PRIORITY เอง)
# GEMINI_MODEL=gemini-3.6-flash

# ระดับความยากตอนเลือกคำลับจาก pool 30 คำ
# 1 = สุ่มได้ทั้ง 30 คำ · 2 = ข้ามคำที่คนรู้จักดีที่สุด (ค่านี้) · 3 = เอาเฉพาะท้าย ๆ
GAME_DIFFICULTY=2