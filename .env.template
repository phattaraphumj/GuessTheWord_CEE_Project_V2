# Copy this file to ".env" in the project root, then fill in the values.

# MongoDB credentials + connection string (Atlas or local)
MONGODB_USERNAME=<YOUR_MONGO_USERNAME>
MONGODB_PASSWORD=<YOUR_MONGO_PASSWORD>
MONGODB_URI=<YOUR_MONGODB_URI>

# API key from Google AI Studio
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Optional: pin a specific Gemini model (default: first available free-tier model in MODEL_PRIORITY)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: game difficulty when picking the secret word
# 1 = pick from all 20 candidates, 2 = skip the most well-known ones (default), 3 = hardest tail only
GAME_DIFFICULTY=2

# Port the backend listens on (must match API_URL in frontend/public/scripts/apiService.js)
PORT_BACKEND=3222