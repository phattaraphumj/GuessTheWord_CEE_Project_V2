{
  "name": "guess-the-word-cee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node --watch backend/src/server.js",
    "start:backend": "node --watch backend/src/server.js",
    "start:frontend": "node --watch frontend/server.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:start:backend\" \"npm:start:frontend\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.12",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}